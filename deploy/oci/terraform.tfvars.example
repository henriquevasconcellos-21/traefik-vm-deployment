# OCI authentication — find these under Profile → My Profile → API Keys
tenancy_ocid     = "ocid1.tenancy.oc1..example"
user_ocid        = "ocid1.user.oc1..example"
fingerprint      = "aa:bb:cc:dd:ee:ff:00:11:22:33:44:55:66:77:88:99"
private_key_path = "~/.oci/oci_api_key.pem"

# Region and placement
region              = "us-ashburn-1"
compartment_ocid    = "ocid1.compartment.oc1..example"
availability_domain = "Uocm:US-ASHBURN-AD-1"

# Access
ssh_public_key = "ssh-rsa AAAAB3NzaC1yc2E..."
ssh_cidr       = "YOUR_IP/32"

# Free tier ARM instance — 1 OCPU + 6 GB RAM + 50 GB disk
# You can scale up to 4 OCPUs and 24 GB RAM total for free
instance_shape          = "VM.Standard.A1.Flex"
ocpus                   = 1
memory_in_gbs           = 6
boot_volume_size_in_gbs = 50

# Tags
owner   = "admin"
purpose = "Traefik Deployment"
